__pycache__/
*.py[cod]
.venv/

runs/
outputs/
journals/
multirun/
charts/

.idea/
.vscode/

# Downloaded datasets and anything converted from them. geometry-of-truth ships
# no LICENSE file, which by default means all rights reserved -- fine to hold and
# work on locally, not something this repo may redistribute. CHEATSHEET.md has the
# fetch and the exact `data convert` line, so both are one command away.
data/external/
data/cities.prompts
data/neg-cities.prompts

# Extracted circuit weights: derived from the checkpoint plus the component
# list in the manifest, 312MB for the 1.7B and past GitHub's file limit. Rebuild
# with `phase1b_extract <config> extract` rather than storing what a command makes.
results/**/phase1b-circuit-weights.pt

# Learned gate logits: one float32 per gated weight, so 769MB for a 201M-gate
# band and ~5.6GB for the whole 1.7B -- past GitHub's file limit by an order of
# magnitude. The artifact JSON beside it records the density and the command,
# which is what a reader needs; rerun `sheaf_prune --save-gates` for the tensor.
results/**/sheaf-*-gates.pt
# The packed mask beside it -- one bit per gate, 168MB on the whole 1.7B and
# ~10MB on a GPT-2 band -- is the circuit itself and the file to back up; it
# stays out of git only because the large ones are past the file limit too.
results/**/sheaf-*-mask.pt

# Run logs. `observe.set_log_file` appends a header per invocation, so these are
# append-only transcripts of a machine rather than results (see 0ceedd9).
results/**/*.log
results/*.log
*.bak
